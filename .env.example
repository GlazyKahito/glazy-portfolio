# Copy to .env.local and fill in values. Never commit .env / .env.local.
#
# GLAZY currently needs no secrets to run. These are reserved for future
# integrations so the pattern is in place before anything is wired up.

# Public site URL (used for metadata, Open Graph, robots and the sitemap).
# Optional on Vercel: the build falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Example: contact form provider key (server-side only, no NEXT_PUBLIC_ prefix).
# CONTACT_FORM_API_KEY=

# Example: GitHub token for a future "GitHub activity" section (server-side only).
# GITHUB_TOKEN=

# Mr. Nimbus's AI. Server-side only; never prefix with NEXT_PUBLIC_.
#
# Free line (default on Vercel, nothing to set): the Vercel AI Gateway, signed
# in with the deployment's own OIDC token and billed to the team's gateway
# credits, with a zero-cost model as the last fallback. For local dev, either
# run `vercel env pull` (gives a short-lived VERCEL_OIDC_TOKEN) or set a key:
AI_GATEWAY_API_KEY=
# Optional overrides (defaults shown).
# NIMBUS_GATEWAY_MODEL=google/gemini-3.1-flash-lite
# NIMBUS_GATEWAY_FALLBACKS=google/gemini-2.5-flash-lite,inclusionai/ling-3.1-flash-free
#
# Direct line (optional): a Google Gemini key takes priority when set.
GEMINI_API_KEY=
# Optional overrides (defaults shown).
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.7-flash

# Search engine ownership tokens (HTML-tag method: the content="..." value).
# Not secrets, but set them in Vercel so the tag ships on every deploy.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
